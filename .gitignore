# Dependencies
node_modules/
**/node_modules/
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.pyc
**/*.pyc

# Environment Files (Do not commit secrets to Git)
.env
**/.env
.env.local
**/.env.local
.env.*.local

# Build & Compilation Outputs
dist/
**/dist/
build/
**/build/
*.egg-info/

# Storage
storage/reports/*.pdf
!storage/reports/.gitkeep

# IDE & OS Artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
